{
  // Repo opened at its root. The uv project and its virtual environment
  //  live under keygen/python, so point Pylance there.
  "python.defaultInterpreterPath": "${workspaceFolder}/keygen/python/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": ["${workspaceFolder}/keygen/python"],
  "python.terminal.activateEnvironment": true
}
